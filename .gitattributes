# Keep deployment scripts and config LF-only, regardless of a contributor's
# core.autocrlf setting — CRLF would break the shebang on Linux
# (`#!/usr/bin/env bash\r` -> "bad interpreter"), break `run:` steps in GitHub
# Actions, and confuse systemd/nginx.
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Node scripts with a #! line: CRLF makes the shebang a syntax error when
# Vitest imports them on a Windows checkout (JL-488).
*.mjs       text eol=lf
