# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/

# Environment files
.env
.env.local
# A hand-made copy of .env is still a copy of .env: the rollback backups taken
# while changing SMTP settings carried SMTP_PASS and JWT_SECRET in cleartext and
# matched none of the patterns around them, so `git add -A` would have committed
# them.
.env.backup*
.env.bak
.env.*.backup
.env.*.local
*.local

# IDE / Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# SQLite database (local dev data)
server/data/*.db
server/data/*.db-journal

# Test coverage
coverage/

# Theme-1 #3: uploaded attachment files (not versioned)
server/uploads/
